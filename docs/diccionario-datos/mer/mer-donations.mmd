    text commission_payer
    integer intended_amount
    integer amount_charged
    text currency
    jsonb breakdown
    text collection_id UK
    text idempotency_key
    text status
    jsonb payer
    boolean anonymous
    timestamp3 created_at
    timestamp3 updated_at
  }
  donation_receipts {
    uuid id PK
    uuid organization_id FK
    uuid donation_id FK,UK
    text dedup_key UK
    jsonb donor
    integer intended_amount
    jsonb breakdown
    timestamp3 issued_at
    timestamp3 created_at

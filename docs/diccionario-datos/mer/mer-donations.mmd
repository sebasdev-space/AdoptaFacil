  donation_certificates {
    uuid id PK
    uuid organization_id
    uuid donation_id FK,UK
    text code UK
    jsonb payload
    text content_hash
    timestamp3 issued_at
    timestamp3 created_at
  }
  donation_access_links {
    uuid id PK
    uuid donation_id FK
    text token_hash UK
    timestamp3 expires_at
    timestamp3 created_at
  }
  organizations {
    uuid id PK
  }
  users {
    uuid id PK
    uuid organization_id FK
  }

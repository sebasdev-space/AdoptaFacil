// Module: reputation (M12, RF23) · Owner: @sebastian
// Review/Rating de organizaciones con arquitectura preparada para moderación
// (S-7). Contenido inmutable tras el envío; solo `status` + columnas de
// moderación transicionan, y únicamente vía las funciones SECURITY DEFINER
// de la migración (la app nunca tiene GRANT UPDATE sobre esta tabla).
//
// `authorUserId` es opcional desde S7-b (cliente, 2026-09-29): el portal
// público admite una reseña ANÓNIMA sin sesión (botón "Registrar reseña" en
// `/o/:slug`), que se inserta vía `create_public_review()` con
// `author_user_id = NULL` y queda `approved` de inmediato (no pasa por la cola
// de PlatformAdmin). El camino de reseña autenticada + interacción verificada
// (`create_review`, RF23 original) sigue exactamente igual. `@@unique` abajo
// no se ve afectado: Postgres trata cada NULL como distinto, así que varias
// reseñas anónimas del mismo org nunca chocan contra la restricción.

model Review {
  id                String    @id @default(uuid()) @db.Uuid
  organizationId    String    @map("organization_id") @db.Uuid
  /// NULL para una reseña anónima del portal público (sin cuenta) — ver nota
  /// de arriba. Reseñas autenticadas (RF23 original) siempre lo tienen.
  authorUserId      String?   @map("author_user_id") @db.Uuid
  rating            Int
  comment           String?
  isAnonymous       Boolean   @default(false) @map("is_anonymous")
  // pending | approved | rejected | hidden — ver ReviewStatus en contracts.
  status            String    @default("pending")
  moderatedByUserId String?   @map("moderated_by_user_id") @db.Uuid
  moderatedAt       DateTime? @map("moderated_at")
  // Motivo del rechazo, o de un ocultamiento posterior (approved -> hidden).
  rejectionReason   String?   @map("rejection_reason")
  createdAt         DateTime  @default(now()) @map("created_at")

  @@unique([organizationId, authorUserId])
  @@index([organizationId])
  @@map("reviews")
}

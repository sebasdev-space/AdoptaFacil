// Module: campaigns (M06) · Owner: @sebastian
// Fundraising campaigns (RF15). Tenant-scoped (organization_id + RLS
// ENABLE+FORCE + tenant_isolation), mirroring the _rls_probe reference in
// org.prisma. Public exposure goes through a SECURITY DEFINER function (only
// public columns), never a raw cross-tenant select.
//
// NOTE (module boundary): the FK to `organizations` is NOT modeled as a Prisma
// @relation (that would edit another owner's Organization model in org.prisma).
// `organizationId` is a plain scalar; the FK (ON DELETE CASCADE) is declared in
// the T-053 migration SQL (same pattern as T-104/T-105).

/// Fundraising campaign (RF15, §9 M06). Money in INTEGER COP pesos. `raised_amount`
/// stays 0 until real donations land (T-055); progress is DERIVED in the API,
/// never stored. Campaigns are soft-managed via `status` (cancelled), never
/// physically deleted by the app role.
model Campaign {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  title          String
  description    String?
  category       String
  goalAmount     Int      @map("goal_amount")
  raisedAmount   Int      @default(0) @map("raised_amount")
  deadline       DateTime
  status         String   @default("active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  evidences          CampaignEvidence[]
  fundingApplications CampaignFundingApplication[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@map("campaigns")
}

/// Idempotency ledger for real campaign funding (RF15 · T-055). One row per
/// APPROVED campaign-attributed donation that has been counted toward a
/// campaign's raised_amount, keyed UNIQUELY by the payment collection_id. Its
/// existence is the persistent "already counted" marker: a repeated webhook
/// (same collection) hits the unique conflict and is a no-op, so the net is added
/// exactly once. Append-only (no update/delete by the app role). Tenant-scoped
/// (organization_id + RLS ENABLE+FORCE + tenant_isolation). Written by a bounded
/// SECURITY DEFINER function so the gateway webhook (no tenant context) can apply
/// it without evading RLS. FK to organizations is declared in the T-055 migration
/// SQL (not a @relation) to avoid editing org.prisma.
model CampaignFundingApplication {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  campaignId     String   @map("campaign_id") @db.Uuid
  collectionId   String   @unique @map("collection_id")
  net            Int
  createdAt      DateTime @default(now()) @map("created_at")

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([campaignId])
  @@map("campaign_funding_applications")
}

/// Spending evidence for accountability (RF16, §9 M06 · T-054): invoices,
/// receipts, proofs and photos an org uploads to show HOW campaign money was
/// used. Tenant-scoped (organization_id + RLS ENABLE+FORCE + tenant_isolation).
/// Money in INTEGER COP pesos (`amount` optional — a photo may carry none). Files
/// go through StoragePort as PUBLIC objects (donor must see them); only the
/// storage ref + business metadata live here. Soft-managed via `deleted_at`
/// (never physically deleted by the app role); edits/removals are audited.
/// Public exposure goes through a SECURITY DEFINER function (public columns
/// only), never a raw cross-tenant select.
///
/// NOTE (module boundary): the campaign FK is a Prisma @relation (intra-module);
/// the FK to `organizations` is declared in the T-054 migration SQL (not as a
/// @relation) to avoid editing org.prisma — another owner's file.
model CampaignEvidence {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  campaignId     String    @map("campaign_id") @db.Uuid
  type           String
  concept        String
  amount         Int?
  spentAt        DateTime  @map("spent_at")
  storageRef     String    @map("storage_ref")
  order          Int       @default(0)
  deletedAt      DateTime? @map("deleted_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([campaignId])
  @@map("campaign_evidences")
}

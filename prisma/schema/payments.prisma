/// La cuenta bancaria REGISTRADA de la organización — único destino de sus
/// payouts (invariante "no custodia": AdoptaFácil nunca agrupa fondos de
/// terceros en un saldo propio, siempre dispersa contra esta cuenta). Datos
/// sensibles (SARLAFT/KYC); nunca se auditan en claro (solo la referencia del
/// payout). Una organización tiene UNA sola cuenta activa (PK = organization_id;
/// registrar de nuevo la reemplaza).
model OrganizationBankAccount {
  organizationId        String   @id @map("organization_id") @db.Uuid
  /// Código del banco en el catálogo de Wompi.
  bankCode               String   @map("bank_code")
  /// BankAccountType: 'savings' | 'checking'.
  accountType            String   @map("account_type")
  accountNumber          String   @map("account_number")
  accountHolderName      String   @map("account_holder_name")
  /// Cédula/NIT del titular (SARLAFT/KYC).
  accountHolderDocument  String   @map("account_holder_document")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  @@map("organization_bank_accounts")
}

/// Un intento de dispersión T+1 (M15b). Idempotente por (organization_id,
/// idempotency_key): un reintento con la misma clave nunca duplica el payout.
/// `attempts`/`lastError` alimentan el reintento escalonado de BullMQ; el
/// estado final (`PayoutStatus`) lo confirma el webhook de Wompi, no la
/// respuesta síncrona de creación. Esta es la tabla que @sebastian leerá desde
/// el dashboard financiero (M13/RF28) — solo lectura desde su lado.
model Payout {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  /// Pesos enteros COP a dispersar.
  amount         Int
  currency       String   @default("COP")
  idempotencyKey String   @map("idempotency_key")
  /// Id del payout en Wompi (null hasta que el dispatch tenga éxito).
  wompiPayoutId  String?  @map("wompi_payout_id")
  /// PayoutStatus como texto: 'scheduled' | 'paid' | 'failed'.
  status         String   @default("scheduled")
  /// Intentos de dispatch realizados (BullMQ `attemptsMade`, reflejado aquí).
  attempts       Int      @default(0)
  /// Mensaje del último fallo de dispatch (diagnóstico; nunca datos bancarios).
  lastError      String?  @map("last_error")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([organizationId, idempotencyKey])
  @@unique([wompiPayoutId])
  @@index([organizationId])
  @@index([status])
  @@map("payouts")
}

/// Split de Pagos 1:1 (T-OAuth-Connect) — the org's OWN MercadoPago account,
/// connected via OAuth so money splits automatically AT the moment of payment
/// (the org gets paid directly; AdoptaFácil keeps a commission). Replaces the
/// consolidated-collection + manual-T+1-payout model above for organizations
/// that connect — this table is ONLY the "connect your account" infra (the
/// OAuth dance + storing the resulting credentials); wiring `mpUserId` into an
/// actual split payment at checkout is a separate follow-up (NOT this task).
/// One row per organization (`organizationId` unique). `accessToken`/
/// `refreshToken` are genuinely needed in plaintext to call MercadoPago's API
/// later — never echoed in a response DTO, log statement, or audit `metadata`
/// (only the EVENT is audited, e.g. `mercadopago_account.connected`, with at
/// most `mpUserId` — never the tokens).
model OrganizationMercadoPagoAccount {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @unique @map("organization_id") @db.Uuid
  /// The org's MercadoPago collector/sponsor id (OAuth `user_id`) — the id
  /// needed later to attribute a split payment to this org's account.
  mpUserId       String   @map("mp_user_id")
  accessToken    String   @map("access_token")
  refreshToken   String   @map("refresh_token")
  /// When `accessToken`/`refreshToken` expire (MercadoPago: ~180 days from
  /// issuance/refresh) — the daily refresh scheduler renews rows within its
  /// configured window BEFORE this date arrives.
  expiresAt      DateTime @map("expires_at")
  connectedAt    DateTime @default(now()) @map("connected_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([organizationId])
  @@index([expiresAt])
  @@map("organization_mercadopago_accounts")
}

// Module: sponsorships (M07) · Owner: @sebastian
// Apadrinamientos recurrentes (RF17, §9/§14 M07). Base slice (T-056): planes +
// suscripción + estado + historial, SIN cobro (T-057 conecta el PaymentPort).
//
// NOTE (module boundary): `animalId` references the M03 `Animal` model (owned by
// the SAME developer, different file) as a PLAIN SCALAR — no cross-file Prisma
// @relation, to keep sponsorships.prisma decoupled from animals.prisma (same
// convention as campaigns→organizations). The FK (ON DELETE CASCADE) is declared
// in the T-056 migration SQL, mirroring T-104/T-105. The FK to `organizations` is
// likewise SQL-only (org.prisma untouched).

/// A recurring-sponsorship PLAN an organization defines for one of its animals
/// (RF17, §14). Money in INTEGER COP pesos (never float). `periodicity` is a
/// CLOSED-for-now enum (`monthly` — the base document's wording); TODO(client):
/// extend if other cadences are requested. `isActive=false` = archived (the org
/// stops offering it; existing sponsorships on it are unaffected). Tenant-scoped
/// (organization_id + RLS ENABLE+FORCE + tenant_isolation).
model SponsorshipPlan {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  animalId       String   @map("animal_id") @db.Uuid
  name           String
  amount         Int
  periodicity    String   @default("monthly")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  sponsorships Sponsorship[]

  @@index([organizationId])
  @@index([animalId])
  @@map("sponsorship_plans")
}

/// A sponsor's (padrino) subscription to a plan (RF17, §14). Lives in the
/// BENEFICIARY org's tenant — the sponsor (a Person) is not a member of that org,
/// so creation is cross-tenant (SECURITY DEFINER, same technique as M05
/// `create_donation`). `animalId` is denormalized from the plan (per the base
/// document's §14 model) for direct query without a join. `status` is the
/// CURRENT state (active|suspended|cancelled); `SponsorshipStatusHistory` is its
/// immutable audit trail. Recurring billing (S-5-REDISEÑO/T-057): the gateway
/// only supports one-shot payment links (no card tokenization) — see
/// `SponsorshipPayment`/`SponsorshipPaymentAttempt` below for the per-period
/// attempt ledger the daily billing job drives off `nextBillingAt`.
model Sponsorship {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  planId         String    @map("plan_id") @db.Uuid
  animalId       String    @map("animal_id") @db.Uuid
  sponsorUserId  String    @map("sponsor_user_id") @db.Uuid
  /// Snapshot of the sponsor's display name AT SUBSCRIBE TIME (same rationale
  /// as `DonationDonor` in donations.prisma — the org's own authenticated view
  /// needs a human name for its supporters; `sponsorUserId` alone is opaque and
  /// the sponsor is never a member of this org, so a live join isn't possible
  /// without a cross-tenant lookup). Captured once by `create_sponsorship(...)`
  /// (T-057 migration) reading `users.display_name`; never updated afterwards
  /// (a later name change by the sponsor does not retroactively rewrite past
  /// sponsorships — same "snapshot, not live" semantics as a donation receipt).
  /// NULL on sponsorships created before this column existed.
  sponsorName    String?   @map("sponsor_name")
  status         String    @default("active")
  startedAt      DateTime  @default(now()) @map("started_at")
  suspendedAt    DateTime? @map("suspended_at")
  cancelledAt    DateTime? @map("cancelled_at")
  /// Next date this sponsorship owes a billing period (S-5-REDISEÑO). Each
  /// sponsorship keeps its OWN anchor (defaults to `now()` at subscribe time,
  /// i.e. the first period starts immediately) so the daily job can tell which
  /// sponsorships are due TODAY without a single fixed billing date for
  /// everyone. Advanced by +1 month by the billing job once a period resolves
  /// (paid or failed) — never by a direct sponsor/org write.
  nextBillingAt  DateTime  @default(now()) @map("next_billing_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  plan     SponsorshipPlan            @relation(fields: [planId], references: [id], onDelete: Cascade)
  history  SponsorshipStatusHistory[]
  payments SponsorshipPayment[]

  @@index([organizationId])
  @@index([planId])
  @@index([animalId])
  @@index([sponsorUserId])
  @@map("sponsorships")
}

/// One BILLING PERIOD of a sponsorship (S-5-REDISEÑO/T-057), `period` = 'YYYY-MM'.
/// `status`: pending (still trying) → paid | failed (terminal). `periodStartedAt`
/// is day-0 of the tolerant reminder/retry ladder (Objetivo 3) — every day-offset
/// threshold is measured from THIS timestamp, never from a fixed calendar date,
/// so the ladder is robust to the daily job catching up after downtime.
/// `attemptCount`/`remindersSent` are the ladder's own persisted state (NOT
/// derived from `attempts.length` — a reminder does not create an attempt row).
/// One row per (sponsorshipId, period) — a period is opened at most once.
model SponsorshipPayment {
  id              String    @id @default(uuid()) @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  sponsorshipId   String    @map("sponsorship_id") @db.Uuid
  period          String
  status          String    @default("pending")
  periodStartedAt DateTime  @default(now()) @map("period_started_at")
  attemptCount    Int       @default(0) @map("attempt_count")
  remindersSent   Int       @default(0) @map("reminders_sent")
  paidAt          DateTime? @map("paid_at")
  failedAt        DateTime? @map("failed_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  sponsorship Sponsorship                 @relation(fields: [sponsorshipId], references: [id], onDelete: Cascade)
  attempts    SponsorshipPaymentAttempt[]

  @@unique([sponsorshipId, period])
  @@index([organizationId])
  @@index([sponsorshipId])
  @@map("sponsorship_payments")
}

/// One payment LINK generated for one period (S-5-REDISEÑO/T-057) — a distinct
/// `PaymentPort.createCollection()` call, never a retry of the same collection
/// (a new link is always a NEW resource with its own `collectionId`). Content is
/// immutable after insert (the migration's trigger enforces this); only `result`
/// transitions, pending → paid | expired (terminal), also trigger-validated.
/// `idempotencyKey` is deterministic per
/// `sponsorship:<sponsorshipId>:<period>:attempt:<attemptNumber>` so a crashed/
/// re-run job step can never create two links for the same attempt.
/// `paymentLinkUrl` is nullable: `PaymentPort.CollectionResult` does not expose a
/// checkout URL today (TODO(client) — see the S-5-REDISEÑO closing report) —
/// populated only once/if that contract gains one additively.
model SponsorshipPaymentAttempt {
  id                   String    @id @default(uuid()) @db.Uuid
  organizationId       String    @map("organization_id") @db.Uuid
  sponsorshipPaymentId String    @map("sponsorship_payment_id") @db.Uuid
  attemptNumber        Int       @map("attempt_number")
  collectionId         String    @map("collection_id")
  paymentLinkUrl       String?   @map("payment_link_url")
  idempotencyKey       String    @unique @map("idempotency_key")
  expiresAt            DateTime  @map("expires_at")
  result               String    @default("pending")
  createdAt            DateTime  @default(now()) @map("created_at")

  payment SponsorshipPayment @relation(fields: [sponsorshipPaymentId], references: [id], onDelete: Cascade)

  @@unique([sponsorshipPaymentId, attemptNumber])
  @@index([organizationId])
  @@index([collectionId])
  @@map("sponsorship_payment_attempts")
}

/// Append-only history of sponsorship status changes (RF17). Same pattern as
/// `FormalizationTransition` (org.prisma): tenant-scoped RLS + immutable (the
/// T-056 migration grants the app role only SELECT+INSERT and installs triggers
/// rejecting UPDATE/DELETE/TRUNCATE). `fromStatus` is null on the row created at
/// subscription time (no prior state). `reason` is free-text, optional — staff
/// may record why (e.g. "fallecimiento del animal", §24 paused/not implemented
/// here); this column is deliberately generic so that future reason keeps working
/// without a schema change.
model SponsorshipStatusHistory {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  sponsorshipId  String   @map("sponsorship_id") @db.Uuid
  fromStatus     String?  @map("from_status")
  toStatus       String   @map("to_status")
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  reason         String?
  createdAt      DateTime @default(now()) @map("created_at")

  sponsorship Sponsorship @relation(fields: [sponsorshipId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([sponsorshipId])
  @@map("sponsorship_status_history")
}
